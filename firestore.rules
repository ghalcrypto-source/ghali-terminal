rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.role is string && data.role.size() >= 1 && data.role.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPriceAlert(data, userId) {
      return data.keys().hasAll(['ownerId', 'symbol', 'targetPrice', 'direction', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'symbol', 'targetPrice', 'direction', 'createdAt'])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.symbol is string && data.symbol.size() >= 2 && data.symbol.size() <= 24 && data.symbol.matches('^[A-Z0-9]+$')
        && (data.targetPrice is int || data.targetPrice is float) && data.targetPrice > 0
        && data.direction in ['ABOVE', 'BELOW']
        && data.createdAt is timestamp;
    }

    // 4. Isolated Private Google Profile (PII strictly restricted to verified owner)
    match /users/{userId}/private/profile {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'role', 'updatedAt']);
      allow delete: if false;
    }

    // 5. User Custom Price Alerts
    match /users/{userId}/alerts/{alertId} {
      allow get: if isValidId(userId) && isValidId(alertId) && isVerifiedOwner(userId);
      allow list: if isValidId(userId) && isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(userId)
        && isValidId(alertId)
        && isVerifiedOwner(userId)
        && isValidPriceAlert(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isValidId(alertId) && isVerifiedOwner(userId);
    }

    // 6. Multi-User Real-Time Room Chat Messages
    function isValidChatMessage(data, roomId, messageId) {
      return data.keys().hasAll(['id', 'roomId', 'senderUid', 'senderName', 'text', 'createdAtMs', 'createdAt'])
        && data.keys().hasOnly(['id', 'roomId', 'senderUid', 'senderName', 'senderEmail', 'senderPhoto', 'senderRole', 'text', 'createdAtMs', 'createdAt'])
        && data.id is string && data.id == messageId && data.id.size() >= 1 && data.id.size() <= 128
        && data.roomId is string && data.roomId == roomId && data.roomId in ['general', 'btc-alpha', 'altcoins', 'macro-fed']
        && data.senderUid is string && data.senderUid == request.auth.uid && data.senderUid.size() >= 1 && data.senderUid.size() <= 128
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120
        && (!data.keys().hasAny(['senderEmail']) || (data.senderEmail is string && data.senderEmail.size() <= 254))
        && (!data.keys().hasAny(['senderPhoto']) || (data.senderPhoto is string && data.senderPhoto.size() <= 512))
        && (!data.keys().hasAny(['senderRole']) || (data.senderRole is string && data.senderRole.size() <= 80))
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && (data.createdAtMs is int || data.createdAtMs is float) && data.createdAtMs > 0
        && data.createdAt is timestamp;
    }

    match /chatRooms/{roomId}/messages/{messageId} {
      allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId);
      allow list: if isSignedIn() && isValidId(roomId) && resource.data.createdAtMs > 0;
      allow create: if isSignedIn()
        && isValidId(roomId)
        && isValidId(messageId)
        && isValidChatMessage(incoming(), roomId, messageId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn()
        && isValidId(roomId)
        && isValidId(messageId)
        && resource.data.senderUid == request.auth.uid;
    }
  }
}
