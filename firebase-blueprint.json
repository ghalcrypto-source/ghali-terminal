{
  "entities": {
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Authenticated Google user profile linked to GHALI TERMINAL.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the authenticated Google user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Verified Google account email address."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "Google account display name."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 512,
          "description": "Google account profile picture URL."
        },
        "role": {
          "type": "string",
          "maxLength": 80,
          "description": "Terminal strategy role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user first linked Google account."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest Google sign-in."
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "PriceAlertRecord": {
      "title": "PriceAlertRecord",
      "description": "Custom crypto price alert owned by an authenticated Google user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "symbol": {
          "type": "string",
          "maxLength": 24,
          "pattern": "^[A-Z0-9]+$",
          "description": "Trading pair symbol (e.g. BTCUSDT)."
        },
        "targetPrice": {
          "type": "number",
          "description": "Target USD trigger price."
        },
        "direction": {
          "type": "string",
          "enum": ["ABOVE", "BELOW"],
          "description": "Alert trigger direction."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["ownerId", "symbol", "targetPrice", "direction", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time multi-user room chat message inside GHALI TERMINAL.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique message identifier."
        },
        "roomId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "enum": ["general", "btc-alpha", "altcoins", "macro-fed"],
          "description": "Chat room channel identifier."
        },
        "senderUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of message author."
        },
        "senderName": {
          "type": "string",
          "maxLength": 120,
          "description": "Display name of the sender."
        },
        "senderEmail": {
          "type": "string",
          "maxLength": 254,
          "description": "Email of the sender."
        },
        "senderPhoto": {
          "type": "string",
          "maxLength": 512,
          "description": "Profile avatar URL."
        },
        "senderRole": {
          "type": "string",
          "maxLength": 80,
          "description": "Role badge of the sender."
        },
        "text": {
          "type": "string",
          "maxLength": 1000,
          "description": "Chat message content."
        },
        "createdAtMs": {
          "type": "number",
          "description": "Epoch timestamp in milliseconds for deterministic ordering."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore server timestamp."
        }
      },
      "required": ["id", "roomId", "senderUid", "senderName", "text", "createdAtMs", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/private/profile": {
      "schema": {
        "$ref": "#/entities/UserPrivateProfile"
      },
      "description": "Isolated PII profile for authenticated Google user."
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": {
        "$ref": "#/entities/PriceAlertRecord"
      },
      "description": "Custom price alerts belonging to authenticated user."
    },
    "/chatRooms/{roomId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Multi-user real-time chat room messages shared across authenticated users."
    }
  }
}
